{
  "name": "whatsapp-widget-generator",
  "private": true,
  "version": "1.0.0",
  "description": "Create and embed a customizable WhatsApp contact widget from a free, open-source web app.",
  "license": "MIT",
  "author": "Alex Garrido",
  "homepage": "https://mralexgarrido.github.io/whatswidget/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mralexgarrido/whatswidget.git"
  },
  "bugs": {
    "url": "https://github.com/mralexgarrido/whatswidget/issues"
  },
  "keywords": [
    "whatsapp",
    "chat-widget",
    "website-widget",
    "embed-generator",
    "react",
    "typescript",
    "open-source"
  ],
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:quality": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check": "npm run check:quality && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.2"
  }
}
